# x402 Agent Service — Environment Configuration
# Copy to .env and fill in your values

# === x402 / Wallet ===
# Your EVM wallet private key (for receiving payments on the server side)
# ⚠️ NEVER commit this to git — use .env and add .env to .gitignore
EVM_PRIVATE_KEY=0x_your_private_key_here
PAY_TO_ADDRESS=0xD333941784201caC6C3c082D9BEef22EFefe4750
NETWORK=eip155:8453

# === CDP Facilitator (for real payments) ===
# CDP API keys for Coinbase CDP Facilitator
# Get from: https://portal.cdp.coinbase.com/settings/api-keys
CDP_API_KEY=your_cdp_api_key_here
CDP_API_SECRET=your_cdp_api_secret_here

# === Facilitator (Fallback) ===
# Default: x402.org facilitator (Coinbase-operated, free)
# Alternatives: CrowPay, MonkePay
FACILITATOR_URL=https://x402.org/facilitator

# === Server ===
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# === Dashboard ===
DASHBOARD_SECRET=changeme

# === Data Sources (optional) ===
# CoinGecko free API: no key needed (rate-limited to 10-30 req/min)
# For higher limits: https://www.coingecko.com/en/api/pricing
# COINGECKO_API_KEY=your_key_here

# === Agent Client (for testing) ===
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_PRIVATE_KEY=0x_your_private_key_here
